{
  "name": "focus-timer",
  "version": "1.0.0",
  "description": "Pomodoro timer with a task list",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/assistant": "5.3.0",
    "@fontsource/secular-one": "5.3.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.focustimer.desktop",
    "productName": "Focus Timer",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "tasksmd.js", "confetti.html", "confetti-preload.js", "build/icon.png", "app/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus Timer"
    }
  }
}
